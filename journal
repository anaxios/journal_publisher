#!/usr/bin/env bash

LOCATION="$WTTR_LOCATION"
WEATHER_CACHE="/tmp/weather"
FILE_NAME="$(today).md"

while getopts "lwe" opt; do
    case "$opt" in
        l)
            CURRENTLY_LISTENING=1
            ;;
        w)
            WEATHER=1
            ;;
        e)
            nb edit interstitial_journal/"$FILE_NAME"
            publish -p
            exit
            ;;
        *)
            echo "bad option"
            exit 1
            ;;
    esac
done
shift $((OPTIND - 1))

weather_ascii() {
    curl --silent "wttr.in/${LOCATION}?0?u?Q?T" > "$WEATHER_CACHE"
    cat "$WEATHER_CACHE"
}

main() {
    if ! which nb &> /dev/null; then
        echo "Requires nb to be installed."
        exit 1
    fi

#    if [[ -p /dev/stdin ]]; then
