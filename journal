        #    weather_ascii | nb edit interstitial_journal/"$FILE_NAME"
        #    echo -e "\n</pre>" | nb edit interstitial_journal/"$FILE_NAME"
        #fi

        echo -e "\n## $(now)" | nb edit interstitial_journal/"$FILE_NAME"

        if [[ $CURRENTLY_LISTENING ]]; then
            echo -e "\n<pre class="ascii-art">" | nb edit interstitial_journal/"$FILE_NAME"
            echo -e "Currently listening to: $(mpc current)" | cowsay | nb edit interstitial_journal/"$FILE_NAME"
